// Deployed by Cloudflare Workers Builds (npx wrangler deploy) on every push to main.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "soic-tracker",
  "account_id": "536b9e65d593d1aed42b4deb34cff2fb",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-15",
  // Only tracker.soictrading.online (behind Cloudflare Access); no workers.dev or preview addresses.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "tracker.soictrading.online", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "services": [{ "binding": "TRACKER_API", "service": "patient-lake-be1f" }]
}
